{
  "$schema": "https://holocron.so/docs.json",
  "name": "ghosthand",
  "description": "Control real iPhones from a Mac with AI agents. Screenshots over USB, taps over Bluetooth.",
  "logo": {
    "light": "/logo-ink.svg",
    "dark": "/logo-white.svg"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#4f46e5"
  },
  "appearance": {
    "default": "system",
    // Always follow the OS setting: no theme picker, no saved choice overriding the dashboard.
    "strict": true
  },
  "icons": {
    "library": "lucide"
  },
  "layout": {
    "mode": "compact"
  },
  "navbar": {
    "links": [
      { "label": "Download", "href": "/download" },
      { "label": "Pricing", "href": "/docs/pricing" },
      { "label": "Log in", "href": "/login" },
      { "label": "Dashboard", "href": "/dashboard" }
    ],
    "primary": { "type": "button", "label": "Start free trial", "href": "/signup" }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/__morse"
    },
    "links": [
      {
        "header": "Legal",
        "items": [
          { "label": "Privacy", "href": "/docs/privacy" },
          { "label": "Terms", "href": "/docs/terms" },
          { "label": "Support", "href": "/docs/support" }
        ]
      }
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "icon": "lucide:book-open",
        "groups": [
          {
            "group": "Getting Started",
            "icon": "lucide:rocket",
            "pages": ["index"]
          },
          {
            "group": "Guides",
            "icon": "lucide:map",
            "pages": ["docs/pricing", "docs/send-media", "docs/xctest-mode"]
          },
          {
            "group": "Internals",
            "icon": "lucide:cpu",
            "pages": ["docs/scroll", "docs/relative-pointer"]
          },
          {
            "group": "Download",
            "icon": "lucide:download",
            "hidden": true,
            "pages": ["download"]
          },
          {
            // Hidden from the sidebar, still served and indexed. Linked from the footer.
            "group": "Legal",
            "hidden": true,
            "pages": ["docs/privacy", "docs/terms", "docs/support"]
          }
        ]
      },
      {
        "tab": "CLI",
        "icon": "lucide:terminal",
        // Generated by scripts/generate-docs.ts from `ghosthand docs-json`.
        "groups": [
          // cli-pages:start
          {
            "group": "Overview",
            "icon": "lucide:terminal",
            "pages": [
              "docs/cli/overview"
            ]
          },
          {
            "group": "Leases",
            "icon": "lucide:key-round",
            "pages": [
              "docs/cli/list",
              "docs/cli/acquire",
              "docs/cli/wait",
              "docs/cli/release"
            ]
          },
          {
            "group": "Screen",
            "icon": "lucide:scan-text",
            "pages": [
              "docs/cli/screenshot",
              "docs/cli/screentext"
            ]
          },
          {
            "group": "Input",
            "icon": "lucide:pointer",
            "pages": [
              "docs/cli/tap",
              "docs/cli/double-tap",
              "docs/cli/triple-tap",
              "docs/cli/hold",
              "docs/cli/swipe",
              "docs/cli/hold-drag",
              "docs/cli/scroll",
              "docs/cli/key",
              "docs/cli/type"
            ]
          },
          {
            "group": "Tasks",
            "icon": "lucide:bot",
            "pages": [
              "docs/cli/task"
            ]
          },
          {
            "group": "iPhone",
            "icon": "lucide:smartphone",
            "pages": [
              "docs/cli/wake",
              "docs/cli/lock",
              "docs/cli/unlock",
              "docs/cli/mute",
              "docs/cli/unmute",
              "docs/cli/assistivetouch",
              "docs/cli/rename",
              "docs/cli/forget",
              "docs/cli/control",
              "docs/cli/info",
              "docs/cli/logs",
              "docs/cli/restart",
              "docs/cli/shutdown"
            ]
          },
          {
            "group": "Recording",
            "icon": "lucide:video",
            "pages": [
              "docs/cli/record-start",
              "docs/cli/record-stop"
            ]
          },
          {
            "group": "Files, photos and apps",
            "icon": "lucide:folder-open",
            "pages": [
              "docs/cli/file-list",
              "docs/cli/file-pull",
              "docs/cli/file-push",
              "docs/cli/file-remove",
              "docs/cli/photo-list",
              "docs/cli/photo-pull",
              "docs/cli/photo-delete",
              "docs/cli/upload",
              "docs/cli/app-list",
              "docs/cli/app-install",
              "docs/cli/app-uninstall"
            ]
          },
          {
            "group": "Setup and account",
            "icon": "lucide:user-round",
            "pages": [
              "docs/cli/setup",
              "docs/cli/setup-status",
              "docs/cli/account",
              "docs/cli/account-login",
              "docs/cli/account-logout",
              "docs/cli/dashboard"
            ]
          },
          {
            "group": "Tunnel and scripts",
            "icon": "lucide:cable",
            "pages": [
              "docs/cli/tunnel-url",
              "docs/cli/tunnel-revoke"
            ]
          },
          {
            "group": "Daemon",
            "icon": "lucide:server",
            "pages": [
              "docs/cli/daemon-start",
              "docs/cli/daemon-stop",
              "docs/cli/daemon-restart",
              "docs/cli/daemon-status",
              "docs/cli/daemon-run"
            ]
          },
          {
            "group": "Random values",
            "icon": "lucide:dices",
            "pages": [
              "docs/cli/random"
            ]
          }
          // cli-pages:end
        ]
      },
      {
        "tab": "API",
        "icon": "lucide:braces",
        // Copy of daemon/Sources/ghosthand/openapi.yaml (the spec the daemon serves), written by generate-docs.
        "openapi": "openapi.yaml",
        "pages": ["docs/api/overview", "..."]
      },
      {
        "tab": "MCP",
        "icon": "lucide:plug",
        // Tool list generated by scripts/generate-docs.ts from the daemon's MCP server.
        // base keeps the generated pages under /docs/* so they never collide with the real /mcp route.
        "mcp": "mcp-tools.json",
        "base": "/docs/mcp",
        "pages": ["docs/mcp/overview", "..."]
      }
    ]
  },
  "decorativeLines": "none",
  // Spiceflow routes in src/server.tsx, not MDX pages.
  "knownPaths": ["/login", "/signup", "/dashboard", "/subscribe", "/device", "/mcp"]
}
