{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ghosthand-website",
  "main": "./src/server.tsx",
  "compatibility_date": "2026-09-01",
  // enable_request_signal: the hub cancels a daemon request when its MCP client disconnects.
  // global_fetch_strictly_public: requireMcpAuth fetches this Worker's own /api/auth/jwks;
  // without it a same-zone fetch skips the Worker and fails ("Jwks failed").
  "compatibility_flags": ["nodejs_compat", "enable_request_signal", "global_fetch_strictly_public"],
  "routes": [
    { "pattern": "ghosthand.dev", "custom_domain": true }
  ],
  // A request makes several sequential database round trips (session, org, tokens): run the
  // Worker in IAD next to PlanetScale (us-east = aws us-east-1). Durable Objects do not move.
  "placement": { "region": "aws:us-east-1" },
  // Prerendered pages (`rendering: static`) are read from build assets through this binding.
  "assets": { "binding": "ASSETS" },
  // PlanetScale Postgres `ghosthand` (org clamordev), caching disabled: auth reads must be fresh.
  // Local: CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE (Sigillo dev) overrides
  // localConnectionString; the build's prerender only needs one to start, it runs no queries.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "8a9f08518c124088bf4570b21900dd55", "localConnectionString": "postgres://ghosthand:local@localhost:5432/ghosthand" }],
  // `ghosthand upload` files. Bucket lifecycle rules delete objects and unfinished multipart uploads after 1 day:
  // wrangler r2 bucket lifecycle add <bucket> expire-1-day --expire-days 1
  // wrangler r2 bucket lifecycle add <bucket> abort-multipart-1-day --abort-multipart-days 1
  "r2_buckets": [
    { "binding": "UPLOADS", "bucket_name": "ghosthand-uploads" },
    { "binding": "RELEASES", "bucket_name": "ghosthand-releases" },
    // Cloud iPhone storage and catalog IPAs (src/cloud/storage.ts). Hosts write it with their own token.
    { "binding": "PHONES", "bucket_name": "ghosthand-phones" }
  ],
  // The Macs that run cloud iPhones (src/cloud/host.ts): each one's private IP is routed by its
  // Cloudflare Tunnel. Remote only: local dev has no hosts. Never add a production host to the
  // preview fleet: two fleets would start phones on the same slots.
  // Virtual network ghosthand-hosts: reaches only the hosts' /32 routes (docs/cloud-hosts.md).
  "vpc_networks": [{ "binding": "HOSTS", "network_id": "cf1:vnet:15b24b76-7c4e-4e31-aa7b-8a8a5698439d" }],
  "durable_objects": {
    "bindings": [
      { "name": "GHOSTHAND_HUB", "class_name": "GhosthandHub" },
      { "name": "GHOSTHAND_TASK", "class_name": "GhosthandTask" },
      { "name": "CLOUD_FLEET", "class_name": "CloudFleet" }
    ]
  },
  // hub-v1: per-tunnel-id DOs replaced by one per user (tunnel.ts); old tunnel state is dropped.
  // task-v1: one object per phone task (task.ts), deleted one day after its last activity.
  // cloud-fleet-v1: the one scheduler of cloud iPhones (src/cloud/fleet.ts).
  "migrations": [
    { "tag": "tunnel-v1", "new_sqlite_classes": ["GhosthandTunnel"] },
    { "tag": "hub-v1", "deleted_classes": ["GhosthandTunnel"], "new_sqlite_classes": ["GhosthandHub"] },
    { "tag": "task-v1", "new_sqlite_classes": ["GhosthandTask"] },
    { "tag": "cloud-fleet-v1", "new_sqlite_classes": ["CloudFleet"] }
  ],
  // A task turn is one invocation with no incoming messages: tool results and model streams
  // all count against one CPU budget (default 30 s).
  "limits": { "cpu_ms": 300000 },
  // Daily source access drift fix (src/lib/github.ts reconcileSourceAccess). Production only.
  "triggers": { "crons": ["17 4 * * *"] },
  // Strada project `ghosthand` (src/telemetry.ts). The id is public; STRADA_TOKEN is a secret.
  "vars": {
    "STRADA_PROJECT_ID": "01M5N4Q0XZ7DS0WXCFEMHHY1PJ",
    "STRADA_ENVIRONMENT": "production",
    // Presigned catalog IPA URLs (src/cloud/storage.ts): the R2 S3 endpoint of PHONES.
    "R2_ACCOUNT_ID": "103e73569e2f6d4aea0fb679ceb8709b",
    "PHONES_BUCKET": "ghosthand-phones"
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "BETTER_AUTH_URL",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "STRIPE_ACCOUNT_ID",
      "STRIPE_SECRET_KEY",
      "STRIPE_WEBHOOK_SECRET",
      "AI_GATEWAY_API_KEY",
      "STRADA_TOKEN",
      "GITHUB_TOKEN",
      // R2 S3 token for ghosthand-phones: presigned catalog IPA downloads for hosts (apps.ts).
      "R2_PHONES_ACCESS_KEY_ID",
      "R2_PHONES_SECRET_ACCESS_KEY",
      // scripts/cloud-host.ts: the admin route that adds, drains and removes hosts.
      "CLOUD_ADMIN_TOKEN"
    ]
  },
  "env": {
    "preview": {
      "name": "ghosthand-website-preview",
      "routes": [
        { "pattern": "preview.ghosthand.dev", "custom_domain": true }
      ],
      "placement": { "region": "aws:us-east-1" },
      // Same database as production for now.
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "8a9f08518c124088bf4570b21900dd55", "localConnectionString": "postgres://ghosthand:local@localhost:5432/ghosthand" }],
      "r2_buckets": [
        { "binding": "UPLOADS", "bucket_name": "ghosthand-uploads-preview" },
        { "binding": "RELEASES", "bucket_name": "ghosthand-releases" },
        { "binding": "PHONES", "bucket_name": "ghosthand-phones-preview" }
      ],
      "vpc_networks": [{ "binding": "HOSTS", "network_id": "cf1:vnet:15b24b76-7c4e-4e31-aa7b-8a8a5698439d" }],
      "durable_objects": {
        "bindings": [
          { "name": "GHOSTHAND_HUB", "class_name": "GhosthandHub" },
          { "name": "GHOSTHAND_TASK", "class_name": "GhosthandTask" },
          { "name": "CLOUD_FLEET", "class_name": "CloudFleet" }
        ]
      },
      "migrations": [
        { "tag": "tunnel-v1", "new_sqlite_classes": ["GhosthandTunnel"] },
        { "tag": "hub-v1", "deleted_classes": ["GhosthandTunnel"], "new_sqlite_classes": ["GhosthandHub"] },
        { "tag": "task-v1", "new_sqlite_classes": ["GhosthandTask"] },
        { "tag": "cloud-fleet-v1", "new_sqlite_classes": ["CloudFleet"] }
      ],
      "limits": { "cpu_ms": 300000 },
      "triggers": { "crons": [] },
      "vars": {
        "STRADA_PROJECT_ID": "01M5N4Q0XZ7DS0WXCFEMHHY1PJ",
        "STRADA_ENVIRONMENT": "preview",
        "R2_ACCOUNT_ID": "103e73569e2f6d4aea0fb679ceb8709b",
        "PHONES_BUCKET": "ghosthand-phones-preview"
      },
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRET",
          "BETTER_AUTH_URL",
          "GOOGLE_CLIENT_ID",
          "GOOGLE_CLIENT_SECRET",
          "STRIPE_ACCOUNT_ID",
          "STRIPE_SECRET_KEY",
          "STRIPE_WEBHOOK_SECRET",
          "AI_GATEWAY_API_KEY",
          "STRADA_TOKEN",
          "GITHUB_TOKEN",
          "R2_PHONES_ACCESS_KEY_ID",
          "R2_PHONES_SECRET_ACCESS_KEY",
          "CLOUD_ADMIN_TOKEN"
        ]
      }
    }
  }
}
