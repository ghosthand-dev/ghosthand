{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ghosthand-website",
  "main": "./src/server.tsx",
  "compatibility_date": "2026-09-01",
  // enable_request_signal: the hub cancels a daemon request when its MCP client disconnects.
  // global_fetch_strictly_public: requireMcpAuth fetches this Worker's own /api/auth/jwks;
  // without it a same-zone fetch skips the Worker and fails ("Jwks failed").
  "compatibility_flags": ["nodejs_compat", "enable_request_signal", "global_fetch_strictly_public"],
  "routes": [
    { "pattern": "ghosthand.dev", "custom_domain": true }
  ],
  // Prerendered pages (`rendering: static`) are read from build assets through this binding.
  "assets": { "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ghosthand-db",
      "database_id": "4bceef41-15fa-4b3e-ab37-65ae9551593a",
      "migrations_dir": "../db/drizzle",
      "migrations_pattern": "../db/drizzle/*/migration.sql"
    }
  ],
  // `ghosthand upload` files. Bucket lifecycle rule deletes objects after 1 day:
  // wrangler r2 bucket lifecycle add <bucket> expire-1-day --expire-days 1
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "ghosthand-uploads" }],
  "durable_objects": {
    "bindings": [
      { "name": "GHOSTHAND_HUB", "class_name": "GhosthandHub" },
      { "name": "GHOSTHAND_TASK", "class_name": "GhosthandTask" }
    ]
  },
  // hub-v1: per-tunnel-id DOs replaced by one per user (tunnel.ts); old tunnel state is dropped.
  // task-v1: one object per phone task (task.ts), deleted one day after its last activity.
  "migrations": [
    { "tag": "tunnel-v1", "new_sqlite_classes": ["GhosthandTunnel"] },
    { "tag": "hub-v1", "deleted_classes": ["GhosthandTunnel"], "new_sqlite_classes": ["GhosthandHub"] },
    { "tag": "task-v1", "new_sqlite_classes": ["GhosthandTask"] }
  ],
  // A task turn is one invocation with no incoming messages: tool results and model streams
  // all count against one CPU budget (default 30 s).
  "limits": { "cpu_ms": 300000 },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "BETTER_AUTH_URL",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "STRIPE_ACCOUNT_ID",
      "STRIPE_SECRET_KEY",
      "STRIPE_WEBHOOK_SECRET",
      "AI_GATEWAY_API_KEY"
    ]
  },
  "env": {
    "preview": {
      "name": "ghosthand-website-preview",
      "routes": [
        { "pattern": "preview.ghosthand.dev", "custom_domain": true }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ghosthand-preview-db",
          "database_id": "bcd41cd8-51df-4a01-90bb-3a748d28acfa",
          "migrations_dir": "../db/drizzle",
          "migrations_pattern": "../db/drizzle/*/migration.sql"
        }
      ],
      "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "ghosthand-uploads-preview" }],
      "durable_objects": {
        "bindings": [
          { "name": "GHOSTHAND_HUB", "class_name": "GhosthandHub" },
          { "name": "GHOSTHAND_TASK", "class_name": "GhosthandTask" }
        ]
      },
      "migrations": [
        { "tag": "tunnel-v1", "new_sqlite_classes": ["GhosthandTunnel"] },
        { "tag": "hub-v1", "deleted_classes": ["GhosthandTunnel"], "new_sqlite_classes": ["GhosthandHub"] },
        { "tag": "task-v1", "new_sqlite_classes": ["GhosthandTask"] }
      ],
      "limits": { "cpu_ms": 300000 },
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRET",
          "BETTER_AUTH_URL",
          "GOOGLE_CLIENT_ID",
          "GOOGLE_CLIENT_SECRET",
          "STRIPE_ACCOUNT_ID",
          "STRIPE_SECRET_KEY",
          "STRIPE_WEBHOOK_SECRET",
          "AI_GATEWAY_API_KEY"
        ]
      }
    }
  }
}
