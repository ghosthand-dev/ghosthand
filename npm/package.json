{
  "name": "ghosthand",
  "version": "0.6.0",
  "description": "Control real iPhones from a Mac with AI agents. Screenshots over USB, taps over Bluetooth. No jailbreak, no Xcode, no app on the phone.",
  "type": "module",
  "bin": "dist/ghosthand",
  "files": [
    "dist"
  ],
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "prepublishOnly": "rimraf dist && pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remorses/ghosthand.git",
    "directory": "npm"
  },
  "homepage": "https://github.com/remorses/ghosthand",
  "bugs": "https://github.com/remorses/ghosthand/issues",
  "keywords": [
    "iphone",
    "ios",
    "automation",
    "ai-agents",
    "bluetooth",
    "hid",
    "screenshot",
    "ocr",
    "assistivetouch",
    "macos",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "rimraf": "^6.0.1"
  }
}
