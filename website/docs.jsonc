{
  "$schema": "https://holocron.so/docs.json",
  "name": "ghosthand",
  "description": "Control real iPhones from a Mac with AI agents. Screenshots over USB, taps over Bluetooth.",
  "logo": {
    "light": "/logo-ink.svg",
    "dark": "/logo-white.svg"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#4f46e5"
  },
  "appearance": {
    "default": "system"
  },
  "icons": {
    "library": "lucide"
  },
  "layout": {
    "mode": "compact"
  },
  "footer": {
    "socials": {
      "x": "https://x.com/__morse"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "icon": "lucide:rocket",
        "pages": ["index"]
      },
      {
        "group": "Internals",
        "icon": "lucide:cpu",
        "pages": ["docs/scroll", "docs/relative-pointer"]
      }
    ]
  },
  "decorativeLines": "none"
}
