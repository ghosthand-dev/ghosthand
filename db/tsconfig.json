{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "drizzle.config.ts"]
}
