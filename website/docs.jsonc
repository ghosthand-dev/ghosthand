{
  "$schema": "https://holocron.so/docs.json",
  "name": "ghosthand",
  "description": "Control real iPhones from a Mac with AI agents. Screenshots over USB, taps over Bluetooth.",
  "logo": {
    "light": "/logo-ink.svg",
    "dark": "/logo-white.svg"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#4f46e5"
  },
  "appearance": {
    "default": "system",
    // Always follow the OS setting: no theme picker, no saved choice overriding the dashboard.
    "strict": true
  },
  "icons": {
    "library": "lucide"
  },
  "layout": {
    "mode": "compact"
  },
  "navbar": {
    "links": [
      { "label": "Log in", "href": "/login" },
      { "label": "Dashboard", "href": "/dashboard" }
    ],
    "primary": { "type": "button", "label": "Start free trial", "href": "/signup" }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/__morse"
    },
    "links": [
      {
        "header": "Legal",
        "items": [
          { "label": "Privacy", "href": "/docs/privacy" },
          { "label": "Terms", "href": "/docs/terms" },
          { "label": "Support", "href": "/docs/support" }
        ]
      }
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "icon": "lucide:book-open",
        "groups": [
          {
            "group": "Getting Started",
            "icon": "lucide:rocket",
            "pages": ["index"]
          },
          {
            "group": "Guides",
            "icon": "lucide:map",
            "pages": ["docs/send-media", "docs/xctest-mode"]
          },
          {
            "group": "Internals",
            "icon": "lucide:cpu",
            "pages": ["docs/scroll", "docs/relative-pointer"]
          },
          {
            // Hidden from the sidebar, still served and indexed. Linked from the footer.
            "group": "Legal",
            "hidden": true,
            "pages": ["docs/privacy", "docs/terms", "docs/support"]
          }
        ]
      },
      {
        "tab": "Pricing",
        "icon": "lucide:credit-card",
        "pages": ["docs/pricing"]
      },
      {
        "tab": "API Reference",
        "icon": "lucide:server",
        // Single source of truth: the spec the daemon is generated from and serves.
        "openapi": "../Sources/ghosthand/openapi.yaml",
        "pages": ["docs/api/overview", "..."]
      }
    ]
  },
  "decorativeLines": "none",
  // Spiceflow routes in src/server.tsx, not MDX pages.
  "knownPaths": ["/login", "/signup", "/dashboard", "/subscribe", "/device"]
}
